{
  "name": "application-releve-photo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Application de relevé photo localisé sur plans PDF (PWA)",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:test": "tsc -b && vite build --mode fichier-unique",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "node tests/e2e/parcours-lot1.mjs && node --experimental-strip-types --no-warnings tests/e2e/terrain-lot3.mjs"
  },
  "dependencies": {
    "idb": "^8.0.4",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "fake-indexeddb": "^6.2.7",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.1.0"
  }
}
